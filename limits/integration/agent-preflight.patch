           sys.exit(main())
+
+      - name: Check out limits code from the default branch
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.event.repository.default_branch }}
+          persist-credentials: false
+          sparse-checkout: |
+            .github/agent-kit/limits
+            .github/agent-kit/metrics
+
+      - name: Restore the metrics store
+        env:
+          GH_TOKEN: ${{ secrets.metrics-store-token }}
+          METRICS_STORE_REPO: ${{ vars.METRICS_STORE_REPO }}
+        run: |
+          set -euo pipefail
+          mkdir -p "$RUNNER_TEMP/metrics-store"
+          # The list isn't ordered by age, so pick the newest unexpired store.
+          id=$(gh api --paginate "repos/$METRICS_STORE_REPO/actions/artifacts?name=metrics-store&per_page=100" --jq '.artifacts[] | select(.expired == false) | [.created_at, .id] | @tsv' | sort | tail -n 1 | cut -f 2)
+          test -n "$id"
+          gh api "repos/$METRICS_STORE_REPO/actions/artifacts/$id/zip" > "$RUNNER_TEMP/metrics-store/store.zip"
+          unzip -q -o "$RUNNER_TEMP/metrics-store/store.zip" metrics.db -d "$RUNNER_TEMP/metrics-store"
+
+      - name: Enforce concurrency, budget and review-queue limits
+        id: limits
+        env:
+          AGENT_BOT_LOGINS: ${{ vars.AGENT_BOT_LOGINS }}
+          AGENT_NAME: ${{ inputs.agent-name }}
+          TARGET_PR: ${{ inputs.target-pr }}
+          GITHUB_TOKEN: ${{ github.token }}
+          LIMITS_ALERT_WEBHOOK: ${{ secrets.limits-alert-webhook }}
+        run: >-
+          python3 .github/agent-kit/limits/scripts/check_limits.py
+          --config .github/agent-kit/limits/config/limits.json
+          --db "$RUNNER_TEMP/metrics-store/metrics.db"
+          --agent "$AGENT_NAME" --target-pr "$TARGET_PR"
