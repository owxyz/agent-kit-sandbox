{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual credential inventory (P0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "security_review",
    "credentials"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "date_or_tbd": {
      "type": "string",
      "pattern": "^(TBD|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "security_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "date"
      ],
      "properties": {
        "reviewer": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "$ref": "#/$defs/date_or_tbd"
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "holder",
          "owner",
          "scope",
          "broad",
          "where_held",
          "removal_date"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pat",
              "deploy-key",
              "github-app-private-key",
              "model-api-key",
              "cloud-key",
              "workflow-token",
              "other"
            ]
          },
          "holder": {
            "$ref": "#/$defs/text"
          },
          "owner": {
            "$ref": "#/$defs/text"
          },
          "scope": {
            "$ref": "#/$defs/text"
          },
          "broad": {
            "type": [
              "boolean",
              "string"
            ],
            "description": "true, false, or TBD until the scope has been checked"
          },
          "where_held": {
            "$ref": "#/$defs/text"
          },
          "removal_date": {
            "type": "string",
            "pattern": "^(TBD|N/A|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
